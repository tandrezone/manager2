# =============================================================================
# manager2 — environment configuration
#
# Copy to .env, fill in, and keep it out of version control.
# In production, prefer a secrets manager over a file: a .env on disk is
# readable by anything running as the web user, including a compromised
# dependency.
#
# Generate every key with:  openssl rand -base64 32
# =============================================================================

# --- Database ----------------------------------------------------------------
M2_DB_DSN="mysql:host=127.0.0.1;port=3306;dbname=manager2;charset=utf8mb4"
M2_DB_USER="manager2_app"
M2_DB_PASSWORD=""
# Path to the CA bundle. Set this whenever the database is not on localhost:
# field-level encryption protects data at rest, not in flight.
M2_DB_SSL_CA=""

# --- Field encryption (AES-256-GCM) ------------------------------------------
# Add a new version to rotate; keep old versions loaded until bin/reencrypt.php
# reports zero rows remaining on them. Removing a version whose ciphertext still
# exists makes that data permanently unreadable.
M2_FIELD_KEY_V1=""
M2_FIELD_KEY_ACTIVE="1"

# --- Blind index (searchable encryption) -------------------------------------
# Independent root, so leaking the searchable index does not leak plaintext.
M2_BLIND_INDEX_KEY_V1=""
M2_BLIND_INDEX_KEY_ACTIVE="1"

# --- Invitation codes --------------------------------------------------------
# Peppers the stored code hash, so database access alone yields no usable invites.
M2_INVITE_PEPPER=""

# --- IP address hashing ------------------------------------------------------
# An IP is personal data (CJEU C-582/14). Keyed, because the IPv4 space is small
# enough to enumerate against an unkeyed hash.
M2_IP_HASH_KEY=""

# --- Payment service provider ------------------------------------------------
# The shared secret from your PSP dashboard, used to verify inbound webhooks.
# Rotate by configuring the new secret at the provider, then here.
M2_PSP_PROVIDER="mbway"
M2_PSP_WEBHOOK_SECRET=""

# --- Notifications -----------------------------------------------------------
M2_BASE_URL="https://portal.example.com"
M2_OPS_EMAILS="ops@example.com,finance@example.com"
M2_MAIL_FROM="no-reply@portal.example.com"
# Optional chat alerting. Leave blank to disable; email remains the record.
M2_CHAT_WEBHOOK_URL=""
M2_CHAT_WEBHOOK_SECRET=""

# --- Controller identity (appears in DSAR exports) ---------------------------
M2_CONTROLLER_NAME="Example Trading Lda"
M2_DPO_EMAIL="dpo@example.com"

# --- Portugal-specific invoicing --------------------------------------------
# The AT-validated series code. Leave blank until you have one: the ATCUD is
# omitted rather than fabricated. Certified invoicing software is a legal
# requirement before issuing real invoices in Portugal.
M2_ATCUD_SERIES_PREFIX=""
